# ==============================================================================
# GiveNearby Git Ignore Configuration
# ==============================================================================

# Environment variables & Sensitive Credentials (NEVER COMMIT)
.env
.env.local
.env.*.local
*.env
backend/.env
backend/.env.local
frontend/.env.local
frontend/.env*.local

# Database & Storage
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3

# Python & Virtual Environments
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
venv/
env/
.venv/

# Node.js & Next.js Build Artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo
next-env.d.ts

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
